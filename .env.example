# JayaMotor Application Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# APPLICATION
# ============================================================================
DEBUG=False
LOG_LEVEL=INFO

# ============================================================================
# DATABASE
# ============================================================================
# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///data/jaya_motor.db
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================================================
# GUI SETTINGS
# ============================================================================
# Window size (width x height in pixels)
WINDOW_WIDTH=1600
WINDOW_HEIGHT=900

# Theme: light or dark
THEME=light

# Enable dark mode support
ENABLE_DARK_MODE=True

# ============================================================================
# BACKUP SETTINGS
# ============================================================================
# Enable automatic database backup
ENABLE_AUTO_BACKUP=True

# Backup interval in seconds (3600 = 1 hour)
AUTO_BACKUP_INTERVAL=3600

# Number of days to keep backups
BACKUP_RETENTION_DAYS=30

# ============================================================================
# PRINTER SETTINGS
# ============================================================================
# Default printer name (leave empty for system default)
PRINTER_NAME=

# Print to PDF instead of physical printer
PRINT_TO_PDF=False

# ============================================================================
# MSSQL MIGRATION (for importing from old system)
# ============================================================================
# Old MSSQL DSN name (if you have ODBC configured)
MSSQL_DSN=Softtech

# Alternative: Full connection string
# MSSQL_CONNECTION_STRING=mssql+pyodbc://@Softtech?driver=ODBC+Driver+17+for+SQL+Server

# ============================================================================
# EMAIL/NOTIFICATION SETTINGS (for future use)
# ============================================================================
# SMTP Server for email notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@jayamotor.com

# ============================================================================
# EXTERNAL API KEYS (for future use)
# ============================================================================
# SMS provider API key
SMS_PROVIDER_API_KEY=

# Other API keys can be added here
